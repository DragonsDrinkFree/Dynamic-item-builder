{{!-- Dynamic Item Builder — three-panel layout --}}
<div class="dib-root">

  {{!-- ══════════════════════════════════════════════════════════
       HEADER BAR
  ══════════════════════════════════════════════════════════ --}}
  <header class="dib-header">
    <div class="dib-header-left">
      <input type="file" id="dib-pdf-input" accept=".pdf" hidden>
      <button type="button" data-action="loadPdf" class="dib-btn">
        <i class="fas fa-folder-open"></i> Load PDF
      </button>
      <span class="dib-pdf-status {{#if hasPdf}}loaded{{/if}}">
        {{#if hasPdf}}
          <i class="fas fa-check-circle"></i> {{pdfName}} ({{pdfPages}} pages)
        {{else}}
          <i class="fas fa-times-circle"></i> No PDF loaded
        {{/if}}
      </span>
    </div>
    <div class="dib-header-right">
      <button type="button" data-action="importRules" class="dib-btn">
        <i class="fas fa-upload"></i> Import Rules
      </button>
      <button type="button" data-action="exportRules" class="dib-btn"
              {{#unless rules.length}}disabled{{/unless}}>
        <i class="fas fa-download"></i> Export Rules
      </button>
      <button type="button" data-action="refreshPreview" class="dib-btn"
              {{#unless hasPdf}}disabled{{/unless}}>
        <i class="fas fa-sync-alt {{#if previewLoading}}fa-spin{{/if}}"></i> Refresh
      </button>
      <button type="button" data-action="buildItems" class="dib-btn dib-btn-primary"
              {{#unless hasPdf}}disabled{{/unless}}>
        <i class="fas fa-hammer"></i> Build Items
      </button>
    </div>
  </header>

  {{!-- ══════════════════════════════════════════════════════════
       THREE PANELS
  ══════════════════════════════════════════════════════════ --}}
  <div class="dib-panels">

    {{!-- ──────────────────────────
         LEFT: Rule List
    ────────────────────────── --}}
    <aside class="dib-panel dib-panel-rules">
      <div class="dib-panel-header">
        <span class="dib-panel-title">Rules</span>
        <button type="button" data-action="addRule" class="dib-btn dib-btn-icon" title="Add rule">
          <i class="fas fa-plus"></i>
        </button>
      </div>

      <ul class="rules-list">
        {{#each rules}}
        <li class="rule-item {{#if (eq this.id ../selectedRuleId)}}active{{/if}}"
            data-rule-id="{{this.id}}" data-action="selectRule">
          <div class="rule-item-body">
            <span class="rule-name">{{this.name}}</span>
            {{#if this.itemType}}
            <span class="rule-badge">{{this.itemType}}</span>
            {{/if}}
            <span class="rule-pages">p.{{this.pages}}</span>
          </div>
          <div class="rule-item-actions">
            <button type="button" data-action="duplicateRule"
                    class="dib-btn dib-btn-icon" title="Duplicate">
              <i class="fas fa-copy"></i>
            </button>
            <button type="button" data-action="deleteRule"
                    class="dib-btn dib-btn-icon dib-btn-danger" title="Delete">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </li>
        {{else}}
        <li class="rules-empty">
          <i class="fas fa-info-circle"></i>
          No rules yet — click <strong>+</strong> to add one.
        </li>
        {{/each}}
      </ul>
    </aside>

    {{!-- ──────────────────────────
         CENTER: Planning Section
         Top bar: Pages + Item Type (shared across both tabs)
         Tab 1: PDF Planner (canvas + region painter)
         Tab 2: Item Planner (rule editor / attribute mapping)
    ────────────────────────── --}}
    <section class="dib-panel dib-panel-editor">

      {{#if selectedRule}}

      {{!-- Shared top bar: page range + item type (compact, no labels) --}}
      <div class="dib-planner-topbar">
        <input type="text" class="dib-topbar-input" data-field="pages"
               value="{{selectedRule.pages}}"
               placeholder="Pages: e.g. 1-25, 45, 50-60"
               title="Pages to scan">
        <select class="dib-topbar-select" data-field="itemType" title="Item Type">
          <option value="">— Item Type —</option>
          {{#each itemTypes}}
          <option value="{{this.value}}"
                  {{#if (eq this.value ../selectedRule.itemType)}}selected{{/if}}>
            {{this.label}}
          </option>
          {{/each}}
        </select>
      </div>

      {{!-- Center tab bar --}}
      <div class="dib-center-tab-bar">
        <button class="dib-tab {{#if plannerTabActive}}active{{/if}}" data-center-tab="planner">
          <i class="fas fa-drafting-compass"></i>
          <span>PDF Planner</span>
          {{#if tableRegionCount}}
          <span class="dib-tab-badge">{{tableRegionCount}}T</span>
          {{/if}}
          {{#if textRegionCount}}
          <span class="dib-tab-badge dib-tab-badge-text">{{textRegionCount}}X</span>
          {{/if}}
        </button>
        <button class="dib-tab {{#if itemPlannerTabActive}}active{{/if}}" data-center-tab="item-planner">
          <i class="fas fa-list-ul"></i>
          <span>Item Planner</span>
        </button>
      </div>

      {{!-- ── PDF PLANNER TAB ── --}}
      <div class="dib-tab-panel {{#if plannerTabActive}}active{{/if}}" id="dib-center-planner">
        {{#if hasPdf}}

        {{!-- Planner toolbar --}}
        <div class="dib-planner-toolbar">
          <div class="dib-planner-page-nav">
            <button class="dib-btn dib-btn-icon" data-planner-nav="prev"
                    {{#if plannerAtFirst}}disabled{{/if}}>
              <i class="fas fa-chevron-left"></i>
            </button>
            <span class="dib-planner-page-label">p.{{plannerPage}}</span>
            <button class="dib-btn dib-btn-icon" data-planner-nav="next"
                    {{#if plannerAtLast}}disabled{{/if}}>
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>

          <div class="dib-planner-tools">
            <button class="dib-btn dib-draw-btn {{#if (eq drawMode "table")}}active{{/if}}"
                    data-draw-mode="table" title="Draw table region">
              <i class="fas fa-table"></i> Table Region
            </button>
            <button class="dib-btn dib-draw-btn {{#if (eq drawMode "text")}}active{{/if}}"
                    data-draw-mode="text" title="Draw text region">
              <i class="fas fa-align-left"></i> Text Region
            </button>
          </div>

          <button class="dib-btn" data-action="autoDetectRegions" title="Auto-detect tables">
            <i class="fas fa-magic"></i> Auto-detect
          </button>
        </div>

        {{!-- Planner content: canvas + sidebar --}}
        <div class="dib-planner-content">

          {{!-- Canvas area --}}
          <div class="dib-planner-canvas-wrap {{#if drawMode}}draw-active{{/if}}">
            <div class="dib-pdf-viewport">
              <canvas id="dib-pdf-canvas"></canvas>
              <div class="dib-region-overlay"></div>
            </div>
          </div>

          {{!-- Region sidebar --}}
          <div class="dib-region-sidebar">
            <div class="dib-region-sidebar-header">
              <i class="fas fa-vector-square"></i> Regions
            </div>
            {{#if selectedRule.regions.length}}
              {{#each selectedRule.regions}}
              <div class="dib-region-list-item dib-region-item-{{this.type}}"
                   data-region-id="{{this.id}}">
                <div class="dib-region-item-header">
                  <span class="dib-region-type-badge">{{this.type}}</span>
                  <input class="dib-region-label-input"
                         type="text"
                         value="{{this.label}}"
                         data-region-field="label"
                         data-region-id="{{this.id}}"
                         placeholder="Label…">
                </div>
                <div class="dib-region-item-meta">
                  <span class="dib-region-page-tag">p.{{this.page}}</span>
                  <input class="dib-region-group-input"
                         type="text"
                         placeholder="group"
                         value="{{this.group}}"
                         data-region-field="group"
                         data-region-id="{{this.id}}"
                         title="Regions in the same group are collated together">
                  <button class="dib-btn dib-btn-icon dib-btn-danger dib-region-del-btn"
                          data-action="deleteRegion"
                          data-region-id="{{this.id}}"
                          title="Remove region">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
              </div>
              {{/each}}
            {{else}}
            <p class="dib-region-empty">
              <i class="fas fa-draw-polygon"></i><br>
              Click <strong>Table Region</strong> or <strong>Text Region</strong>,
              then drag on the PDF to define extraction areas.
            </p>
            {{/if}}
          </div>

        </div>{{!-- /.dib-planner-content --}}

        {{else}}
        <div class="scan-empty">
          <i class="fas fa-file-pdf fa-2x"></i>
          <p>Load a PDF using the button above to start planning regions.</p>
        </div>
        {{/if}}
      </div>{{!-- /#dib-center-planner --}}

      {{!-- ── ITEM PLANNER TAB ── --}}
      <div class="dib-tab-panel {{#if itemPlannerTabActive}}active{{/if}}" id="dib-center-item-planner">
        <div class="rule-editor-inner">

          {{!-- Rule name --}}
          <fieldset class="dib-fieldset">
            <legend>General</legend>
            <div class="dib-form-row">
              <div class="dib-field dib-field-grow">
                <label>Rule Name</label>
                <input type="text" data-field="name" value="{{selectedRule.name}}">
              </div>
              <div class="dib-field dib-field-grow">
                <label>Content Type</label>
                <select data-field="contentType">
                  {{#each contentTypes}}
                  <option value="{{this.value}}"
                          {{#if (eq this.value ../selectedRule.contentType)}}selected{{/if}}>
                    {{this.label}}
                  </option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="dib-form-row">
              <div class="dib-field dib-field-grow">
                <label><i class="fas fa-folder"></i> Destination Folder</label>
                <select data-field="folderId">
                  <option value="">— No Folder (root) —</option>
                  {{#each itemFolders}}
                  <option value="{{this.id}}"
                          {{#if (eq this.id ../selectedRule.folderId)}}selected{{/if}}>
                    {{this.name}}
                  </option>
                  {{/each}}
                </select>
              </div>
            </div>
          </fieldset>

          {{!-- Detection patterns --}}
          <fieldset class="dib-fieldset">
            <legend>Detection Patterns</legend>

            {{#if (eq selectedRule.contentType "table")}}
            <div class="dib-field">
              <label>Header Row Pattern
                <span class="dib-hint">Regex matching any text in the column header row</span>
              </label>
              <input type="text" data-field="headerPattern"
                     value="{{selectedRule.headerPattern}}"
                     placeholder="e.g. Weapon|Name|Item">
            </div>
            {{/if}}

            {{#if (eq selectedRule.contentType "column")}}
            <div class="dib-field">
              <label>Item Start Pattern
                <span class="dib-hint">Regex marking the beginning of each item in prose text</span>
              </label>
              <input type="text" data-field="rowDetectionPattern"
                     value="{{selectedRule.rowDetectionPattern}}"
                     placeholder="e.g. ^[A-Z][a-z]+ [\w]+ \(">
            </div>
            {{/if}}

            {{#if (eq selectedRule.contentType "mixed")}}
            <div class="dib-field">
              <label>Item Start Pattern
                <span class="dib-hint">For prose side of mixed layout</span>
              </label>
              <input type="text" data-field="rowDetectionPattern"
                     value="{{selectedRule.rowDetectionPattern}}"
                     placeholder="Regex to detect item start in prose column">
            </div>
            <div class="dib-field">
              <label>Description Target Field
                <span class="dib-hint">e.g. system.description</span>
              </label>
              <input type="text" data-field="descriptionField"
                     value="{{selectedRule.descriptionField}}"
                     placeholder="system.description">
            </div>
            {{/if}}

            <div class="dib-field">
              <label>Skip Pattern
                <span class="dib-hint">Rows matching this regex are ignored</span>
              </label>
              <input type="text" data-field="skipPattern"
                     value="{{selectedRule.skipPattern}}"
                     placeholder="e.g. ^\s*$ or ^-+$">
            </div>
          </fieldset>

          {{!-- Font filter --}}
          <fieldset class="dib-fieldset">
            <legend>Font Filter <span class="dib-hint">(optional)</span></legend>
            <div class="dib-form-row">
              <div class="dib-field dib-field-grow">
                <label>Font Name Contains</label>
                <input type="text" data-field="fontFilter.name"
                       value="{{selectedRule.fontFilter.name}}"
                       placeholder="e.g. Bold, Italic, Times">
              </div>
              <div class="dib-field">
                <label>Min Size</label>
                <input type="number" data-field="fontFilter.minSize"
                       value="{{selectedRule.fontFilter.minSize}}" min="0" placeholder="—">
              </div>
              <div class="dib-field">
                <label>Max Size</label>
                <input type="number" data-field="fontFilter.maxSize"
                       value="{{selectedRule.fontFilter.maxSize}}" min="0" placeholder="—">
              </div>
            </div>
          </fieldset>

          {{!-- Attribute mappings --}}
          <fieldset class="dib-fieldset">
            <legend>
              Attribute Mappings
              <button type="button" data-action="addAttribute"
                      class="dib-btn dib-btn-sm" style="float:right">
                <i class="fas fa-plus"></i> Add Field
              </button>
            </legend>

            <div class="attributes-list">
              {{#each selectedRule.attributes}}
              <div class="attr-row" data-attr-index="{{@index}}">
                <div class="attr-row-header">
                  <span class="attr-label">
                    {{#if this.foundryField}}
                      <strong>{{this.foundryField}}</strong>
                    {{else}}
                      Attribute {{@index}}
                    {{/if}}
                  </span>
                  <button type="button" data-action="deleteAttribute"
                          class="dib-btn dib-btn-icon dib-btn-danger">
                    <i class="fas fa-times"></i>
                  </button>
                </div>

                <div class="dib-form-row">
                  <div class="dib-field dib-field-grow">
                    <label>Foundry Field</label>
                    <select data-field="foundryField">
                      <option value="">— select field —</option>
                      {{#each ../attributePaths}}
                      <option value="{{this.path}}"
                              {{#if (eq this.path ../foundryField)}}selected{{/if}}>
                        {{this.path}}
                      </option>
                      {{/each}}
                    </select>
                  </div>
                </div>

                <div class="dib-form-row">
                  {{#if (eq ../selectedRule.contentType "table")}}
                  <div class="dib-field dib-field-grow">
                    <label>Column Header
                      <span class="dib-hint">Exact column heading text</span>
                    </label>
                    <input type="text" data-field="columnHeader"
                           value="{{this.columnHeader}}"
                           placeholder="e.g. Damage">
                  </div>
                  {{/if}}

                  <div class="dib-field dib-field-grow">
                    <label>Refine Regex
                      <span class="dib-hint">Optional — extract sub-match from cell text</span>
                    </label>
                    <input type="text" data-field="pattern"
                           value="{{this.pattern}}"
                           placeholder="e.g. (\d+d\d+)">
                  </div>
                  <div class="dib-field dib-field-narrow">
                    <label>Group</label>
                    <input type="number" data-field="group"
                           value="{{this.group}}" min="0">
                  </div>
                  <div class="dib-field">
                    <label>Transform</label>
                    <select data-field="transform">
                      {{#each ../transforms}}
                      <option value="{{this.value}}"
                              {{#if (eq this.value ../transform)}}selected{{/if}}>
                        {{this.label}}
                      </option>
                      {{/each}}
                    </select>
                  </div>
                </div>
              </div>
              {{else}}
              <p class="attr-empty">
                <i class="fas fa-info-circle"></i>
                No attributes yet. Click <strong>Add Field</strong> to map PDF columns to item fields.
              </p>
              {{/each}}
            </div>
          </fieldset>

        </div>{{!-- /.rule-editor-inner --}}
      </div>{{!-- /#dib-center-item-planner --}}

      {{else}}
      {{!-- No rule selected --}}
      <div class="dib-no-selection">
        <i class="fas fa-arrow-left fa-2x"></i>
        <p>Select a rule from the list, or create a new one with <strong>+</strong>.</p>
      </div>
      {{/if}}

    </section>

    {{!-- ──────────────────────────
         RIGHT: Preview Section
         Tab 1: Table Preview
         Tab 2: Text Preview
         Tab 3: Item Preview
    ────────────────────────── --}}
    <aside class="dib-panel dib-panel-preview">

      {{!-- Tab bar --}}
      <div class="dib-tab-bar">
        <button class="dib-tab {{#if tablesTabActive}}active{{/if}}" data-tab="tables">
          <i class="fas fa-table"></i>
          <span>Table Preview</span>
          {{#if scanData}}
          <span class="dib-tab-badge">{{scanData.tables.length}} tbl</span>
          {{/if}}
          {{#if previewLoading}}
          <span class="dib-loading"><i class="fas fa-spinner fa-spin"></i></span>
          {{/if}}
        </button>
        <button class="dib-tab {{#if textTabActive}}active{{/if}}" data-tab="text">
          <i class="fas fa-align-left"></i>
          <span>Text Preview</span>
          {{#if textData}}
          <span class="dib-tab-badge">{{textData.sections.length}} sec</span>
          {{/if}}
          {{#if previewLoading}}
          <span class="dib-loading"><i class="fas fa-spinner fa-spin"></i></span>
          {{/if}}
        </button>
        <div class="dib-tab-sep"></div>
        <button class="dib-tab {{#if previewTabActive}}active{{/if}}" data-tab="preview">
          <i class="fas fa-eye"></i>
          <span>Items Preview</span>
          {{#if previewLoading}}
          <span class="dib-loading"><i class="fas fa-spinner fa-spin"></i></span>
          {{/if}}
        </button>
      </div>

      {{!-- ── TABLE PREVIEW ── --}}
      <div class="dib-tab-panel {{#if tablesTabActive}}active{{/if}}" id="dib-tab-tables">
        <div class="dib-scan-content">
          {{#if scanData}}

            {{#each scanData.tables}}
            <div class="scan-table-wrap">
              <div class="scan-table-label">
                <i class="fas fa-table"></i> Table {{@index}}
                <span class="scan-col-count">
                  {{this.columns.length}} columns · {{this.rows.length}} rows
                </span>
              </div>
              <div class="scan-table-scroll">
                <table class="scan-table">
                  <thead>
                    <tr>
                      {{#each this.columns}}
                      <th class="scan-cell scan-header-cell"
                          data-scan="header-cell"
                          data-column="{{this.header}}"
                          title="Click to map or set header pattern">
                        {{#if this.header}}{{this.header}}{{else}}<em class="dib-unlabeled">(unlabeled)</em>{{/if}}
                      </th>
                      {{/each}}
                    </tr>
                  </thead>
                  <tbody>
                    {{#each this.rows}}
                    <tr>
                      {{#each this.cells}}
                      <td class="scan-cell scan-data-cell"
                          data-scan="data-cell"
                          data-column="{{this.column}}"
                          data-value="{{this.value}}"
                          title="Click to skip or map">
                        {{this.value}}
                      </td>
                      {{/each}}
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
            {{/each}}

            {{#if scanData.proseRows.length}}
            <div class="scan-prose-section">
              <div class="scan-prose-label"><i class="fas fa-align-left"></i> Other Text</div>
              {{#each scanData.proseRows}}
              <div class="scan-prose-row"
                   data-scan="prose"
                   data-text="{{proseText this}}"
                   title="Click to set as Item Start Pattern">
                {{proseText this}}
              </div>
              {{/each}}
            </div>
            {{/if}}

          {{else}}
          <div class="scan-empty">
            <i class="fas fa-file-pdf"></i>
            <p>Draw table regions in the <strong>PDF Planner</strong>, then click <strong>Refresh</strong>.</p>
          </div>
          {{/if}}
        </div>
      </div>

      {{!-- ── TEXT PREVIEW ── --}}
      <div class="dib-tab-panel {{#if textTabActive}}active{{/if}}" id="dib-tab-text">
        <div class="text-scan-content">
          {{#if textData.sections.length}}
            {{#each textData.sections}}
            <div class="text-section">

              {{#if this.header}}
              <div class="text-section-header">{{this.header}}</div>
              {{/if}}

              {{#if this.intro}}
              <div class="text-section-intro">{{this.intro}}</div>
              {{/if}}

              {{#each this.entries}}
              <div class="text-entry"
                   data-scan="text-entry"
                   data-name="{{this.name}}"
                   data-description="{{this.description}}"
                   title="Click to use this entry">
                <span class="text-entry-name">{{this.name}}</span>
                {{#if this.description}}
                <span class="text-entry-desc">{{this.description}}</span>
                {{/if}}
              </div>
              {{/each}}

            </div>
            {{/each}}
          {{else}}
          <div class="scan-empty">
            <i class="fas fa-align-left"></i>
            <p>Draw text regions in the <strong>PDF Planner</strong>, then click <strong>Refresh</strong>.</p>
          </div>
          {{/if}}
        </div>
      </div>

      {{!-- ── ITEMS PREVIEW ── --}}
      <div class="dib-tab-panel {{#if previewTabActive}}active{{/if}}" id="dib-tab-preview">

        <div class="dib-preview-toolbar">
          <button class="dib-btn-sm" data-action="preview-select-all">Select All</button>
          <button class="dib-btn-sm" data-action="preview-deselect-all">Deselect All</button>
          <button class="dib-btn-sm dib-btn-danger" data-action="preview-remove" disabled>Remove</button>
        </div>

        <div class="preview-list">
          {{#if previewSummary.length}}
            {{#each previewSummary}}
            <div class="preview-rule" data-rule-id="{{this.id}}">
              <div class="preview-rule-header">
                <span class="preview-rule-name">{{this.name}}</span>
                {{#if this.items}}
                <span class="preview-count-badge">{{this.items.length}} item(s)</span>
                {{else}}
                <span class="preview-count-badge empty">—</span>
                {{/if}}
              </div>

              {{#if this.items.length}}
              {{#if this.columns.length}}
              <div class="preview-table-scroll">
                <table class="preview-table">
                  <thead>
                    <tr>
                      {{#each this.columns}}
                      <th class="preview-th" title="{{this.field}}">{{this.label}}</th>
                      {{/each}}
                    </tr>
                  </thead>
                  <tbody>
                    {{#each this.items}}
                    <tr class="preview-tr" data-item-key="{{this._key}}">
                      {{#each ../columns}}
                      <td class="preview-td">{{getField .. this.field}}</td>
                      {{/each}}
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
              {{else}}
              <p class="preview-none">No attribute mappings defined for this rule.</p>
              {{/if}}
              {{else if this.items}}
              <p class="preview-none">No items detected — check rules and refresh.</p>
              {{else}}
              <p class="preview-none">Click <strong>Refresh</strong> to run this rule.</p>
              {{/if}}

            </div>
            {{/each}}
          {{else}}
          <div class="preview-empty">
            <i class="fas fa-eye fa-2x"></i>
            <p>Add rules, load a PDF, and hit Refresh.</p>
          </div>
          {{/if}}
        </div>

        {{#if hasIgnoredItems}}
        <div class="dib-ignore-section">
          <div class="dib-ignore-toolbar">
            <span class="dib-ignore-label"><i class="fas fa-ban"></i> Ignored</span>
            <button class="dib-btn-sm" data-action="ignore-select-all">Select All</button>
            <button class="dib-btn-sm" data-action="ignore-deselect-all">Deselect All</button>
            <button class="dib-btn-sm dib-btn-ok" data-action="ignore-restore" disabled>Restore</button>
          </div>
          <div class="ignore-list">
            {{#each previewSummary}}
            {{#if this.ignoredItems.length}}
            <div class="ignore-rule" data-rule-id="{{this.id}}">
              <div class="ignore-rule-header">
                <span class="ignore-rule-name">{{this.name}}</span>
                <span class="preview-count-badge">{{this.ignoredItems.length}} ignored</span>
              </div>
              {{#if this.columns.length}}
              <div class="preview-table-scroll">
                <table class="preview-table">
                  <thead>
                    <tr>
                      {{#each this.columns}}
                      <th class="preview-th" title="{{this.field}}">{{this.label}}</th>
                      {{/each}}
                    </tr>
                  </thead>
                  <tbody>
                    {{#each this.ignoredItems}}
                    <tr class="ignore-tr" data-item-key="{{this._key}}">
                      {{#each ../columns}}
                      <td class="preview-td">{{getField .. this.field}}</td>
                      {{/each}}
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
              {{else}}
              {{#each this.ignoredItems}}
              <div class="ignore-tr" data-item-key="{{this._key}}">
                <span class="ignore-item-name">{{this.name}}</span>
              </div>
              {{/each}}
              {{/if}}
            </div>
            {{/if}}
            {{/each}}
          </div>
        </div>
        {{/if}}

      </div>{{!-- /#dib-tab-preview --}}

    </aside>

  </div>{{!-- /.dib-panels --}}
</div>{{!-- /.dib-root --}}
